{
  "name": "paywise-front",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "tunnel": "cloudflared tunnel --config .cloudflared/config.yml run paywise-tunnel",
    "dev:tunnel": "concurrently -n NEXT,TUNNEL -c blue,green \"npm run dev\" \"npm run tunnel\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gen:api": "openapi-ts",
    "type-check": "tsc --noEmit",
    "prepare": "if [ \"$NODE_ENV\" != \"production\" ]; then husky; fi"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "npx prettier --write"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-query": "^5.90.21",
    "@twa-dev/sdk": "^8.0.2",
    "@twa-dev/types": "^8.0.2",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "jalaali-js": "^1.2.8",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.575.0",
    "motion": "^12.34.0",
    "next": "^16.1.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.92.4",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/jalaali-js": "^1.2.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
